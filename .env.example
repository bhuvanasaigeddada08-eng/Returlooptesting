# Flask Backend Configuration
FLASK_APP=backend/run.py
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-key

# Database (defaults to SQLite local file in backend/instance/returnloop.db)
DATABASE_URL=sqlite:///instance/returnloop.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/returnloop_lpu

# File Upload Settings
UPLOAD_FOLDER=backend/uploads
MAX_CONTENT_LENGTH=5242880

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,capacitor://localhost

# Initial Development Administrator Provisioning
DEV_ADMIN_NAME=Campus Security Admin
DEV_ADMIN_EMAIL=admin@returnloop.lpu.in
DEV_ADMIN_PASSWORD=AdminPass123!

# Frontend Environment Variables (in frontend/.env)
VITE_API_BASE_URL=http://127.0.0.1:5000
